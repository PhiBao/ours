# Server-side only. Never expose this to the browser, never commit a real value.
# Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Set to 1 to bypass the response cache and force fresh model calls (calibration only).
# The cache is on by default so a re-run never touches the network — see spec.md > Failure Modes.
TYPESAFE_FRESH=